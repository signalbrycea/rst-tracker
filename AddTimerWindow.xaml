<Window x:Class="RS3Tracker.AddTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add timer" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="Search" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
    <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown" ToolTip="Type part of a name, for example yak or toadflax"/>
    <ListBox x:Name="Results" MaxHeight="220" Margin="0,4,0,0" Visibility="Collapsed"
             SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_DoubleClick" KeyDown="Results_KeyDown"/>

    <TextBlock Text="Category" Foreground="{DynamicResource MutedBrush}" Margin="0,14,0,4"/>
    <ComboBox x:Name="CategoryBox" SelectionChanged="Category_Changed"/>

    <TextBlock Text="Thing to time" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/>
    <ComboBox x:Name="ItemBox" SelectionChanged="Item_Changed"/>

    <StackPanel x:Name="StagePanel" Visibility="Collapsed">
      <TextBlock Text="Grow until" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/>
      <ComboBox x:Name="StageBox" SelectionChanged="Stage_Changed"/>
    </StackPanel>

    <TextBlock Text="Label (optional)" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,4"/>
    <TextBox x:Name="LabelBox" KeyDown="Label_KeyDown" ToolTip="For example: north patch, yak pen 2"/>

    <TextBlock x:Name="Info" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button Grid.Column="1" Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
      <Button Grid.Column="2" x:Name="AddButton" Style="{StaticResource AccentButton}" Content="Add and start" Click="Add_Click" MinWidth="120" IsEnabled="False"/>
    </Grid>
  </StackPanel>
</Window>
