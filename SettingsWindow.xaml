<Window x:Class="RS3Tracker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <TextBlock Text="Sound" FontSize="15" FontWeight="SemiBold"/>
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Volume" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <Slider Grid.Column="1" x:Name="VolumeSlider" Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
              VerticalAlignment="Center" ValueChanged="Volume_Changed"/>
      <TextBlock Grid.Column="2" x:Name="VolumeText" VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="36" TextAlignment="Right"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <CheckBox x:Name="MuteBox" Content="Mute" Checked="Mute_Changed" Unchecked="Mute_Changed" VerticalAlignment="Center"/>
      <Button Content="Test sound" Click="Test_Click" Margin="20,0,0,0"/>
    </StackPanel>
    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Alert sound" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBlock Grid.Column="1" x:Name="SoundName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedBrush}"/>
      <Button Grid.Column="2" Content="Browse" Click="Browse_Click" Margin="10,0,0,0" ToolTip="Pick a WAV or MP3 file"/>
      <Button Grid.Column="3" x:Name="ClearSoundButton" Content="Use built-in" Click="ClearSound_Click" Margin="6,0,0,0" ToolTip="Go back to the built-in chime"/>
    </Grid>
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
               Text="WAV or MP3. Only the first 10 seconds play. If the file goes missing, the built-in chime plays instead."/>

    <TextBlock Text="Window" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0"/>
    <CheckBox x:Name="TopBox" Content="Keep window on top of the game" Margin="0,10,0,0" Checked="Top_Changed" Unchecked="Top_Changed"/>
    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
               Text="Minimising sends the app to the tray next to the clock. Closing the window quits, timers are kept and keep counting while closed."/>

    <TextBlock Text="Timers" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0"/>
    <CheckBox x:Name="ConfirmBox" Content="Ask before resetting a timer" Margin="0,10,0,0" Checked="Confirm_Changed" Unchecked="Confirm_Changed"/>
    <CheckBox x:Name="ConfirmRemoveBox" Content="Ask before removing a timer" Margin="0,8,0,0" Checked="Confirm_Changed" Unchecked="Confirm_Changed"/>

    <TextBlock Text="Files" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,0"/>
    <TextBlock x:Name="CatalogPath" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock x:Name="StatePath" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

    <Grid Margin="0,16,0,0">
      <TextBlock x:Name="AboutText" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
      <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" MinWidth="80"/>
    </Grid>
  </StackPanel>
</Window>
