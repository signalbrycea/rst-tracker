<Window x:Class="RS3Tracker.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="18,16,18,14">
    <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Yes" Click="Yes_Click" MinWidth="80" IsDefault="True"/>
      <Button Content="No" Click="No_Click" MinWidth="80" Margin="10,0,0,0" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
